DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/umbral
POSTGRES_DB=umbral
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Meta application credentials. Keep them out of the database and Django Admin.
META_APP_SECRET=change-me
META_WEBHOOK_VERIFY_TOKEN=change-me-long-random-string
META_GRAPH_API_VERSION=v23.0
META_SYSTEM_USER_TOKEN=replace-with-system-user-token

# WhatsApp Cloud API
WHATSAPP_GRAPH_API_VERSION=v23.0

# OpenAI
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini
